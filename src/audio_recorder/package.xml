<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>audio_recorder</name>
  <version>0.1.0</version>
  <description>Captures a microphone (wireless lavalier USB receiver) and publishes timestamped PCM audio for rosbag2 recording.</description>
  <maintainer email="ama.hasheminejad@gmail.com">Mahsa Hasheminejad</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>audio_common_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- sounddevice has no rosdep key: pip install sounddevice (needs libportaudio2) -->
  <exec_depend>libportaudio2</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
